# Servidor SMTP desde el que se envían los formularios de contacto
SMTP_HOST=mail.costavia.com.ar
SMTP_PORT=465
SMTP_USER=info@costavia.com.ar
SMTP_PASSWORD=
# Opcional: dirección que figura como remitente (por defecto usa SMTP_USER)
SMTP_FROM=info@costavia.com.ar
# Opcional: destinatario de las consultas (por defecto info@costavia.com.ar)
CONTACT_TO=info@costavia.com.ar
